#!/usr/bin/env bash
# Drain a repo's ready-for-agent queue: one fresh headless `/work-queue` run per issue.
#
#   agent-listener [--interval SECS] [--once] [--dry-run] [--watch] [--babysit] [DIR]
#
# --watch runs each session interactively in a window of the `agents` tmux session, with
# Remote Control on, so you can follow or steer it with `tmux attach -t agents` or from the
# Claude app. The window closes once the session has sat idle for a minute.
# --babysit (implies --watch) resumes a session that opened a PR in its own window to handle the
# Codex review (step 7 of /work-queue), in the background so the queue keeps draining. The session
# polls the PR every minute; the window closes once it has sat idle for 5 minutes, when the PR is
# merged or closed, or after 90 minutes.
# DIR defaults to the current directory and must be set up with /setup-matt-pocock-skills.
# The tracker is read from docs/agents/issue-tracker.md. GitHub, GitLab and local-markdown
# trackers are checked from bash before Claude starts (GitHub also skips blocked, assigned and
# spec issues, so no session starts for blocked work); any other tracker (Linear, Jira, ...)
# starts a run every interval and lets /work-queue check.
set -euo pipefail

interval=600
once=false
dry_run=false
watch=false
babysit=false
dir=.

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interval) interval="$2"; shift 2 ;;
    --once) once=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    --watch) watch=true; shift ;;
    --babysit) watch=true; babysit=true; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) dir="$1"; shift ;;
  esac
done

die() { echo "agent-listener: $*" >&2; exit 1; }

root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "$dir is not inside a git repo"
cd "$root"

for f in docs/agents/issue-tracker.md docs/agents/triage-labels.md; do
  [[ -f $f ]] || die "$root has no $f; run /setup-matt-pocock-skills there first"
done
[[ -e ~/.claude/skills/work-queue/SKILL.md ]] || die "work-queue skill isn't installed; run npm run sync:skills in skill-index"
command -v claude >/dev/null || die "claude CLI not on PATH"
if $watch; then
  for c in tmux jq uuidgen; do command -v $c >/dev/null || die "--watch needs $c"; done
  ! $babysit || command -v gh >/dev/null || die "--babysit needs gh"
  # An untrusted folder holds the session at the trust prompt before it starts work.
  trusted=$(jq --arg root "$root" '[.projects // {} | to_entries[]
    | select(.value.hasTrustDialogAccepted == true) | .key as $k
    | select($k == $root or ($root | startswith($k + "/")))]
    | length > 0' ~/.claude.json 2>/dev/null || echo false)
  [[ $trusted == true ]] || die "Claude doesn't trust $root yet; run claude there once and accept the trust prompt"
fi

# The label string mapped to the ready-for-agent role (second column of its table row).
ready=$(awk -F'|' '$2 ~ /`ready-for-agent`/ { gsub(/[` ]/, "", $3); print $3; exit }' docs/agents/triage-labels.md)
ready=${ready:-ready-for-agent}
human=$(awk -F'|' '$2 ~ /`ready-for-human`/ { gsub(/[` ]/, "", $3); print $3; exit }' docs/agents/triage-labels.md)
human=${human:-ready-for-human}

tracker=$(sed -n 's/^# Issue tracker: *//p' docs/agents/issue-tracker.md | head -1 | tr '[:upper:]' '[:lower:]')
case "$tracker" in
  github) command -v gh >/dev/null || die "tracker is GitHub but gh isn't installed" ;;
  gitlab) command -v glab >/dev/null || die "tracker is GitLab but glab isn't installed" ;;
esac

# Exit 0 when the queue has an issue /work-queue would pick: no spec label, no assignee, no
# open blockers. On GitHub that is checked here, so a queue of blocked tickets never starts
# a session. Other trackers can't check blockers from bash; /work-queue does and reports
# "queue empty", which sends us back to sleep.
# On GitHub it also sets next_issue to the issue /work-queue should pick (the oldest), which
# names the tmux window.
next_issue=""
has_work() {
  next_issue=""
  case "$tracker" in
    github)
      local candidates open
      # Native dependencies (blocked_by counts open blockers only) plus the body-line fallback.
      candidates=$(gh api --paginate "repos/{owner}/{repo}/issues?state=open&labels=$ready&sort=created&direction=asc&per_page=100" \
        --jq '.[] | select(.pull_request == null and .assignee == null
            and all(.labels[]; .name != "spec")
            and ((.issue_dependencies_summary.blocked_by // 0) == 0))
          | [.number, ((.body // "") | split("\n") | map(select(test("^\\s*Blocked by:"; "i"))) | first // "")]
          | @tsv') || return 0   # API trouble: let /work-queue decide
      [[ -n $candidates ]] || return 1
      open=$(gh issue list --state open --limit 500 --json number -q '.[].number')
      local num line ref
      while IFS=$'\t' read -r num line; do
        for ref in $(grep -oE '#[0-9]+' <<<"$line" || true); do
          grep -qx "${ref#\#}" <<<"$open" && continue 2
        done
        next_issue=$num
        return 0
      done <<<"$candidates"
      return 1 ;;
    gitlab)
      [[ $(glab issue list --label "$ready" --not-label spec --output json | tr -d '[:space:]') != "[]" ]] ;;
    "local markdown")
      grep -Eqs "^\**Status:\**[[:space:]]*$ready" .scratch/*/issues/*.md ;;
    *) return 0 ;;
  esac
}

name=$(basename "$root")
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/agent-listener
mkdir -p "$state_dir"
log="$state_dir/$name.log"

# One listener per repo.
lock="$state_dir/$name.lock"
mkdir "$lock" 2>/dev/null || die "already listening on $root (remove $lock if it's stale)"
trap 'rmdir "$lock"' EXIT

# Backstop for the power settings: no idle sleep while this runs.
if command -v caffeinate >/dev/null; then caffeinate -i -w $$ & fi

say() { echo "[$(date '+%F %T')] $*" | tee -a "$log"; }
prompt="/work-queue"
tmux_session=agents
last_session="$state_dir/$name.last-session"

run_headless() { claude -p "$prompt" --dangerously-skip-permissions 2>&1; }

# Run one interactive session in a tmux window and print its last reply once it goes idle.
run_watched() {
  local id window status transcript="" started=false idle_polls=0 polls=0 title=${next_issue:+#$next_issue}
  title=${title:-$name}
  id=$(uuidgen | tr '[:upper:]' '[:lower:]')
  echo "$id" > "$last_session"
  tmux has-session -t "=$tmux_session" 2>/dev/null || tmux new-session -d -s "$tmux_session" -c "$root"
  window=$(tmux new-window -d -P -F '#{window_id}' -t "=$tmux_session:" -n "$title" -c "$root" \
    claude --session-id "$id" --remote-control "$name ${next_issue:+#$next_issue }queue $(date +%H:%M)" \
      --dangerously-skip-permissions "$prompt")
  say "session $id in tmux window $tmux_session:$window; tmux attach -t $tmux_session, or open it in the Claude app" >&2

  # Started = the transcript holds a reply (a 5s poll can miss a short busy spell).
  # Done = started, then idle for 12 polls in a row (a minute, so a reply from your phone keeps it alive).
  while (( idle_polls < 12 )); do
    sleep 5
    polls=$((polls + 1))
    tmux list-windows -a -F '#{window_id}' | grep -qx "$window" || { say "window closed" >&2; break; }
    if ! $started; then
      [[ -n $transcript ]] || transcript=$(find ~/.claude/projects -maxdepth 2 -name "$id.jsonl" | head -1)
      if [[ -n $transcript ]] && jq -es 'any(.[]; .type == "assistant")' "$transcript" >/dev/null 2>&1; then
        started=true
      else
        if (( polls == 24 )); then
          say "session hasn't replied after 2 minutes; it may be waiting on input: tmux attach -t $tmux_session" >&2
        fi
        continue
      fi
    fi
    status=$(claude agents --json 2>/dev/null | jq -r --arg id "$id" '.[] | select(.sessionId == $id) | .status' || true)
    if [[ $status == idle ]]; then idle_polls=$((idle_polls + 1)); else idle_polls=0; fi
  done
  tmux kill-window -t "$window" 2>/dev/null || true
  say "session $id done; reopen with: claude --resume $id" >&2

  [[ -n $transcript ]] || transcript=$(find ~/.claude/projects -maxdepth 2 -name "$id.jsonl" | head -1)
  [[ -n $transcript ]] || return 1
  jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text] | last // ""' "$transcript"
}

# Resume the session that opened PR $2 for issue $3 in its own window so it can work through the
# Codex review. Runs in the background; ends after 5 idle minutes (the session is done polling),
# when the PR leaves the open state, or after 90 minutes.
babysit_pr() {
  local id=$1 pr=$2 title=${3:+#$3} window status waited=0 idle_polls=0
  title="${title:-$name} review"
  window=$(tmux new-window -d -P -F '#{window_id}' -t "=$tmux_session:" -n "$title" -c "$root" \
    claude --resume "$id" --dangerously-skip-permissions \
      "Babysit the review of $pr: run step 7 of /work-queue now.")
  say "babysitting $pr in tmux window $tmux_session:$window (session $id)" >&2
  while (( waited < 5400 && idle_polls < 10 )); do
    sleep 30
    waited=$((waited + 30))
    tmux list-windows -a -F '#{window_id}' | grep -qx "$window" || { say "babysit window for $pr closed" >&2; return; }
    [[ $(gh pr view "$pr" --json state -q .state 2>/dev/null || echo OPEN) == OPEN ]] || break
    status=$(claude agents --json 2>/dev/null | jq -r --arg id "$id" '.[] | select(.sessionId == $id) | .status' || true)
    if [[ $status == idle ]]; then idle_polls=$((idle_polls + 1)); else idle_polls=0; fi
  done
  tmux kill-window -t "$window" 2>/dev/null || true
  say "stopped babysitting $pr" >&2
}

if $watch; then run=run_watched; else run=run_headless; fi

say "listening on $root (tracker: ${tracker:-unknown}, label: $ready, every ${interval}s); log: $log"

while true; do
  if has_work; then
    if $dry_run; then
      say "work found; would run /work-queue"
    else
      say "work found${next_issue:+ (#$next_issue)}; running $prompt"
      started_at=$(date -u +%FT%TZ)
      if out=$($run | tee -a "$log"); then
        if $babysit; then
          # The reply may say "PR #58" without a URL, so ask GitHub for the PR this run opened.
          pr=$(gh pr list --state open --label "$human" --json number,createdAt \
            -q "[.[] | select(.createdAt >= \"$started_at\")] | sort_by(.createdAt) | last | .number // empty" 2>/dev/null || true)
          [[ -n $pr ]] || pr=$(grep -oE 'https://[^ )>]+/pull/[0-9]+' <<<"$out" | tail -1 || true)
          sid=$(cat "$last_session")
          if [[ -n $pr ]]; then babysit_pr "$sid" "$pr" "$next_issue" & fi
        fi
        # Drain straight on to the next issue unless the queue reported empty.
        if ! $once && ! grep -qi "queue empty" <<<"$out"; then continue; fi
      else
        say "claude exited non-zero; backing off"
      fi
    fi
  else
    say "queue empty"
  fi
  if $once; then wait; break; fi
  sleep "$interval"
done
